<nav title-text="家庭中心" />

<view class="my">
  <!-- 账户卡 -->
  <view class="account">
    <view class="account__avatar">
      <t-icon name="user" size="64rpx" color="#15816C" />
    </view>
    <view class="account__info">
      <view class="account__name">{{loggedIn ? phone : '未登录'}}</view>
      <view class="account__sub">家庭账户 · 一个账号管理全家口腔健康</view>
    </view>
  </view>

  <block wx:if="{{loggedIn}}">
    <!-- 家庭成员 -->
    <view class="section">
      <view class="section__head">
        <view class="section__title">家庭成员</view>
        <view class="section__action" bindtap="onAddMember">+ 添加</view>
      </view>

      <view class="member" wx:for="{{members}}" wx:key="id">
        <view class="member__avatar">{{item.name ? item.name[0] : '?'}}</view>
        <view class="member__body">
          <view class="member__name">{{item.name}}</view>
          <view class="member__meta">{{roleText(item.role)}}{{item.birth ? ' · ' + item.birth : ''}}</view>
        </view>
      </view>

      <view class="empty" wx:if="{{!members.length}}">
        <view class="empty__text">还没有成员，点击右上角添加</view>
      </view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </block>

  <view class="guest" wx:else>
    <t-icon name="user-circle" size="120rpx" color="#d5dbe6" />
    <view class="guest__text">登录后管理家庭成员</view>
  </view>

  <!-- 添加成员弹层 -->
  <view class="mask" wx:if="{{showForm}}" bindtap="onCloseForm"></view>
  <view class="sheet" wx:if="{{showForm}}">
    <view class="sheet__head">
      <view class="sheet__title">添加家庭成员</view>
      <t-icon name="close" size="44rpx" color="#999999" bindtap="onCloseForm" />
    </view>

    <view class="field">
      <view class="field__label">称呼</view>
      <view class="seg">
        <view
          wx:for="{{roleOptions}}"
          wx:key="key"
          class="seg__item {{form.role === item.key ? 'seg__item--active' : ''}}"
          data-role="{{item.key}}"
          bindtap="onPickRole"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">姓名</view>
      <input class="input" placeholder="请输入姓名" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="field__label">出生年月</view>
      <input class="input" placeholder="如 2016-06" value="{{form.birth}}" data-field="birth" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="field__label">性别</view>
      <view class="seg">
        <view class="seg__item {{form.gender === 'male' ? 'seg__item--active' : ''}}" data-gender="male" bindtap="onPickGender">男</view>
        <view class="seg__item {{form.gender === 'female' ? 'seg__item--active' : ''}}" data-gender="female" bindtap="onPickGender">女</view>
      </view>
    </view>

    <view class="btn-primary" bindtap="submitMember">保存</view>
  </view>
</view>
