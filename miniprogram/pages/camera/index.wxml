<nav title-text="图片收集" />

<view class="camera-page">
  <!-- 拍摄区域 -->
  <view class="stage">
    <camera
      wx:if="{{!img}}"
      class="stage__camera"
      device-position="back"
      flash="auto"
    >
      <cover-view class="guide">
        <cover-view class="guide__box"></cover-view>
        <cover-view class="guide__tip">将牙齿对准框内，保持光线充足</cover-view>
      </cover-view>
    </camera>
    <image wx:else class="stage__preview" src="{{img}}" mode="aspectFit" />
  </view>

  <!-- 选择视角 -->
  <view class="panel">
    <view class="panel__label">拍摄部位</view>
    <view class="seg">
      <view
        class="seg__item {{view === 'occlusal' ? 'seg__item--active' : ''}}"
        data-view="occlusal"
        bindtap="onSwitchView"
      >上/下颌咬合面</view>
      <view
        class="seg__item {{view === 'buccal' ? 'seg__item--active' : ''}}"
        data-view="buccal"
        bindtap="onSwitchView"
      >唇颊面</view>
    </view>
    <view class="panel__hint">建议同时拍摄上颌与下颌，各一张</view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <block wx:if="{{!img}}">
      <view class="shutter" bindtap="takePhoto">
        <view class="shutter__inner"></view>
      </view>
      <view class="actions__tip">点击拍照</view>
    </block>
    <block wx:else>
      <view class="btn-row">
        <view class="btn-ghost" bindtap="retake">重拍</view>
        <view class="btn-primary {{uploading ? 'btn-primary--disabled' : ''}}" bindtap="upload">
          {{uploading ? '分析中...' : '上传分析'}}
        </view>
      </view>
    </block>
  </view>
</view>
