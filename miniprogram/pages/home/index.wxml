<view class="home">
  <!-- 品牌 Hero + 成员切换 -->
  <view class="hero">
    <view class="hero__title">守护每一次微笑</view>
    <view class="hero__sub">AI 智能口腔筛查 · 家校医协同管理</view>

    <!-- 未登录 -->
    <view class="login" wx:if="{{!loggedIn}}">
      <view class="login__row">
        <input class="login__input" type="number" maxlength="11" placeholder="请输入手机号"
               value="{{phone}}" bindinput="onPhoneInput" />
        <view class="login__btn" bindtap="onLogin">登录</view>
      </view>
      <view class="login__tip">一个账号管理全家口腔健康</view>
    </view>

    <!-- 已登录：成员切换 -->
    <view class="members" wx:else>
      <scroll-view class="members__scroll" scroll-x enable-flex>
        <view
          wx:for="{{members}}"
          wx:key="id"
          class="member {{currentMemberId === item.id ? 'member--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSwitchMember"
        >
          <view class="member__avatar">{{item.name ? item.name[0] : '?'}}</view>
          <view class="member__name">{{roleText(item.role)}}</view>
        </view>
        <view class="member member--add" bindtap="onManage">
          <view class="member__avatar member__avatar--add">+</view>
          <view class="member__name">添加</view>
        </view>
      </scroll-view>

      <!-- 当前成员健康概览 -->
      <view class="overview" wx:if="{{currentMember}}">
        <view class="overview__left">
          <view class="overview__name">{{currentMember.name}}</view>
          <view class="overview__meta">{{currentMember.gender === 'male' ? '男' : currentMember.gender === 'female' ? '女' : ''}} {{currentMember.birth || ''}}</view>
        </view>
        <view class="overview__risk">
          <view class="overview__risk-label">口腔风险</view>
          <view class="overview__risk-value" style="color: {{riskColor}}">{{riskText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="body">
    <block wx:if="{{loggedIn}}">
      <view class="grid">
        <view class="grid__item" bindtap="onDetect">
          <view class="grid__icon grid__icon--green">
            <t-icon name="camera" size="56rpx" color="#07C160" />
          </view>
          <view class="grid__label">拍照筛查</view>
          <view class="grid__desc">拍摄口腔照片</view>
        </view>
        <view class="grid__item" bindtap="onQuestionnaire">
          <view class="grid__icon grid__icon--cyan">
            <t-icon name="edit" size="56rpx" color="#10AEFF" />
          </view>
          <view class="grid__label">健康问卷</view>
          <view class="grid__desc">生活习惯评估</view>
        </view>
        <view class="grid__item" bindtap="onRecords">
          <view class="grid__icon grid__icon--orange">
            <t-icon name="history" size="56rpx" color="#FF9500" />
          </view>
          <view class="grid__label">检测记录</view>
          <view class="grid__desc">历史报告</view>
        </view>
      </view>

      <!-- 护牙计划入口 -->
      <view class="card cell" hover-class="cell--hover" bindtap="onRecords">
        <view class="cell__icon cell__icon--green">
          <t-icon name="check-circle" size="44rpx" color="#07C160" />
        </view>
        <view class="cell__body">
          <view class="cell__title">护牙计划</view>
          <view class="cell__desc">护理、学习、就诊待办与反馈</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#CCCCCC" />
      </view>
    </block>

    <view class="empty-tip" wx:else>登录后开始使用</view>
  </view>
</view>
