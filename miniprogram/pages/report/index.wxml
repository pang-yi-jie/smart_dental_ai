<nav title-text="检测报告" />

<view class="report" wx:if="{{caseData}}">
  <!-- 状态卡 -->
  <view class="status-card status-card--{{caseData.status}}">
    <view class="status-card__text">{{statusText}}</view>
    <view class="status-card__meta">
      牙位 {{caseData.tooth_position || '未填'}} · {{caseData.view === 'occlusal' ? '咬合面' : '唇颊面'}}
    </view>
  </view>

  <!-- AI 标注图 -->
  <view class="card" wx:if="{{annotatedUrl}}">
    <view class="card__title">AI 标注结果</view>
    <image class="annotated" src="{{annotatedUrl}}" mode="widthFix" bindtap="onPreview" />
    <view class="hint">点击图片可放大查看</view>
  </view>

  <!-- 检测明细 -->
  <view class="card">
    <view class="card__title">检测明细（{{detections.length}}）</view>
    <view class="chips" wx:if="{{detections.length}}">
      <view class="chip" wx:for="{{detections}}" wx:key="index">
        <text class="chip__label">{{item.label}}</text>
        <text class="chip__conf">{{item.confidence * 100}}%</text>
      </view>
    </view>
    <view class="empty" wx:else>本张图片未检出牙位目标</view>
  </view>

  <!-- 医生意见 -->
  <view class="card" wx:if="{{doctorSuggestion}}">
    <view class="card__title">医生诊断意见</view>
    <view class="doctor-note">{{doctorSuggestion}}</view>
  </view>

  <!-- 好物推荐 -->
  <view class="card" wx:if="{{recommendProducts.length}}">
    <view class="card__title">{{recommendTitle}}</view>
    <view
      class="product"
      wx:for="{{recommendProducts}}"
      wx:key="id"
      data-code="{{item.taobao_code}}"
      bindtap="onBuy"
    >
      <view class="product__info">
        <view class="product__name">{{item.title}}</view>
        <view class="product__desc">{{item.description || item.category}}</view>
      </view>
      <view class="product__buy">{{item.price || '去购买'}}</view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    本结果由 AI 辅助生成，仅供医生参考，不构成最终诊断。如有不适请及时就医。
  </view>

  <!-- 底部操作 -->
  <view class="bottom-btns">
    <view class="btn-ghost" bindtap="onRetake">重新检测</view>
    <view class="btn-primary" bindtap="onBackHome">返回首页</view>
  </view>
</view>

<view class="loading" wx:else>
  <t-loading theme="circular" size="60rpx" />
  <view class="loading__text">加载中...</view>
</view>
