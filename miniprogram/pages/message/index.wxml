<nav title-text="检测记录" />

<view class="records">
  <!-- 成员切换 -->
  <scroll-view class="switcher" scroll-x enable-flex>
    <view
      wx:for="{{members}}"
      wx:key="id"
      class="switcher__item {{currentMemberId === item.id ? 'switcher__item--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSwitchMember"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 检测记录列表 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">检测记录</view>
      <view class="section__action" bindtap="onNewDetect">+ 新检测</view>
    </view>

    <view wx:if="{{!records.length}}" class="empty">
      <t-icon name="file" size="88rpx" color="#d5dbe6" />
      <view class="empty__text">暂无检测记录</view>
      <view class="empty__btn" bindtap="onNewDetect">开始第一次检测</view>
    </view>

    <view
      class="record"
      wx:for="{{records}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpenRecord"
    >
      <view class="record__left">
        <view class="record__risk" style="color: {{item.riskColor}}">{{item.riskText}}</view>
        <view class="record__meta">检出 {{item.detCount}} 处 · {{item.dateText}}</view>
      </view>
      <t-icon name="chevron-right" size="36rpx" color="#c5ccd9" />
    </view>
  </view>

  <!-- 护牙计划 -->
  <view class="section" wx:if="{{tasks.length}}">
    <view class="section__title">护牙计划</view>
    <view class="task" wx:for="{{tasks}}" wx:key="id">
      <view class="task__type">{{item.type}}</view>
      <view class="task__status">{{item.status}}</view>
    </view>
  </view>
</view>
