.hero {
  padding: 80rpx 40rpx 40rpx;
  color: #fff;
  background: linear-gradient(135deg, #2f6df6, #6a9cff);
}
.hero .title { font-size: 52rpx; font-weight: 700; }
.hero .sub { margin-top: 16rpx; font-size: 28rpx; opacity: .9; }
.label { font-size: 28rpx; color: #666; margin-bottom: 16rpx; }
.input {
  border: 1rpx solid #ddd; border-radius: 12rpx;
  padding: 20rpx; margin-bottom: 24rpx;
}
.ok { color: #07c160; font-size: 30rpx; }
.big { margin: 40rpx 24rpx; padding: 24rpx; font-size: 34rpx; }
