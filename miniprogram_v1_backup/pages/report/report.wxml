<view class="page" wx:if="{{caseData}}">
  <view class="card">
    <view class="status">状态：{{statusText(caseData.status)}}</view>
    <view class="meta">
      牙位：{{caseData.tooth_position || '未填'}}　视角：{{caseData.view === 'occlusal' ? '咬合面' : '唇颊面'}}
    </view>
  </view>

  <view class="card" wx:if="{{annotatedUrl}}">
    <view class="h">AI 标注结果</view>
    <image class="img" src="{{annotatedUrl}}" mode="widthFix" />
  </view>

  <view class="card">
    <view class="h">检测明细（{{detections.length}}）</view>
    <view class="det" wx:for="{{detections}}" wx:key="index">
      <text class="det-label">{{item.label}}</text>
      <text class="det-conf">置信度 {{item.confidence}}</text>
    </view>
    <view wx:if="{{!detections.length}}" class="empty">未检出目标</view>
  </view>
</view>
