<view class="page">
  <view wx:if="{{!list.length}}" class="empty">暂无推荐商品</view>
  <view class="card item" wx:for="{{list}}" wx:key="id">
    <view class="info">
      <view class="title">{{item.title}}</view>
      <view class="desc">{{catText(item.category)}}<text wx:if="{{item.price}}"> · {{item.price}}</text></view>
    </view>
    <button class="btn-primary buy" size="mini" data-code="{{item.taobao_code}}" bindtap="buy">购买</button>
  </view>
</view>
