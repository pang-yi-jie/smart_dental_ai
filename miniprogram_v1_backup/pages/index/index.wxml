<view class="page">
  <view class="hero">
    <view class="title">口腔 AI 检测</view>
    <view class="sub">拍照 · 智能分析 · 医生复核</view>
  </view>

  <view class="card">
    <block wx:if="{{!loggedIn}}">
      <view class="label">手机号登录（首次使用）</view>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号"
             value="{{phone}}" bindinput="onPhoneInput" />
      <button class="btn-primary" bindtap="login">登录</button>
    </block>
    <block wx:else>
      <view class="ok">✓ 已登录，可以开始检测</view>
    </block>
  </view>

  <button class="btn-primary big" bindtap="startDetect">开始检测</button>
</view>
